# Core
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
PROJECT_NAME="Europe Job Agent"

# Database
DATABASE_URL=postgresql+asyncpg://jobuser:jobpass@postgres:5432/jobagent
DATABASE_URL_SYNC=postgresql://jobuser:jobpass@postgres:5432/jobagent

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# AWS (optional for local, required for production)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=jobagent-resumes-dev

# Notifications
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Crawler
CRAWLER_INTERVAL_HOURS=4
MAX_CONCURRENT_CRAWLS=5
USER_AGENT="EuropeJobAgent/1.0 (+https://yourdomain.com/bot)"

# Local AI pipeline
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
VECTOR_BACKEND=numpy
TOP_JOBS_FOR_OLLAMA=20
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=llama3.1:8b

# Frontend
FRONTEND_URL=http://localhost:3001
